# ---- Connexa platform (paste real tokens here, then restart) ----

# Admin password for /dashboard (default: dev-admin)
CONNEXA_ADMIN_TOKEN=dev-admin

# Real connector tokens (optional - leave empty to use the simulated lane)
CONNEXA_SLACK_TOKEN=          # xoxb-... Bot User OAuth Token (scopes: chat:write, channels:read, auth)
CONNEXA_NOTION_TOKEN=         # ntn_... internal integration token
CONNEXA_GITHUB_TOKEN=         # ghp_... (scopes: repo for issue create)

# OAuth "social login" lane (optional - register a free app at each provider, paste ids here).
# When set, authenticate_<slug> / .../oauth/<slug>/start return a real authorization URL
# and /oauth/<slug>/callback completes the exchange for individual users.
# CONNEXA_REDIRECT_BASE must match the public base URL of this deployment.
CONNEXA_REDIRECT_BASE=http://localhost:8000
CONNEXA_SLACK_CLIENT_ID=      # Slack app: api.slack.com/apps -> OAuth & Permissions
CONNEXA_SLACK_CLIENT_SECRET=
CONNEXA_NOTION_CLIENT_ID=     # Notion integration: notion.so/my-integrations (public OAuth)
CONNEXA_NOTION_CLIENT_SECRET=
CONNEXA_GMAIL_TOKEN=          # rarely needed; Google OAuth lane preferred
CONNEXA_GMAIL_CLIENT_ID=      # Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
CONNEXA_GMAIL_CLIENT_SECRET=
CONNEXA_GITHUB_OAUTH_CLIENT_ID=   # GitHub: Settings -> Developer settings -> OAuth Apps
CONNEXA_GITHUB_OAUTH_CLIENT_SECRET=

# Real LLM vendor keys for the Gateway lane (optional; connexa-echo is the built-in fallback model)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server
CONNEXA_HOST=127.0.0.1
CONNEXA_PORT=8000
