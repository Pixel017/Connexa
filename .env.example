# Copy to .env and fill in what you want. Everything is optional except in production.

# Admin console token (CHANGE THIS in production — /login uses it)
CONNEXA_ADMIN_TOKEN=dev-admin

# Where the SQLite file lives (docker-compose sets it to /data/connexa.db)
# CONNEXA_DB=/data/connexa.db

# Public base URL (used to build OAuth redirect URIs)
CONNEXA_REDIRECT_BASE=https://your-domain.example

# ---- Real connectors (all optional; free tiers available at each provider) ----
# GitHub (REAL ticketing data lane + agent tools): a fine-grained PAT with repo read
CONNEXA_GITHUB_TOKEN=
# Slack bot token (xoxb-...) for the live Slack lane
CONNEXA_SLACK_TOKEN=
# Notion integration token for the live Notion lane
CONNEXA_NOTION_TOKEN=

# ---- OAuth "sign in with provider" apps (register free at each provider) ----
CONNEXA_GITHUB_OAUTH_CLIENT_ID=
CONNEXA_GITHUB_OAUTH_CLIENT_SECRET=
CONNEXA_SLACK_CLIENT_ID=
CONNEXA_SLACK_CLIENT_SECRET=
CONNEXA_NOTION_CLIENT_ID=
CONNEXA_NOTION_CLIENT_SECRET=

# ---- Model providers for the Gateway (optional; connexa-echo works without) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Credential vault: encrypt provider credentials at rest (recommended in production) ----
CONNEXA_ENC_KEY=

# ---- Console SSO: IdP signs an HS256 assertion (JWT bearer); issuer scopes it ----
CONNEXA_SSO_SECRET=
CONNEXA_SSO_ISSUER=

# ---- Self-serve upgrades (optional): a Stripe payment link for the Growth plan ----
CONNEXA_STRIPE_PAYMENT_LINK=
